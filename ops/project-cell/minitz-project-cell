#!/usr/bin/env bash
set -Eeuo pipefail

readonly SELF="$(readlink -f "${BASH_SOURCE[0]}")"
readonly SANDBOX_ROOT="${MINITZ_OS_SANDBOX_ROOT:-/root/attached-storage/minitz-os-sandbox}"
readonly INSTALLED_PREFIX="/usr/local/lib/minitz-ai/"
if [[ -n "${MINITZ_SOURCE_ROOT:-}" ]]; then
  SOURCE_ROOT="$(readlink -f "$MINITZ_SOURCE_ROOT")"
elif [[ "$SELF" == "$INSTALLED_PREFIX"* ]]; then
  SOURCE_ROOT="$(readlink -f "$SANDBOX_ROOT/system/current/opt/minitz/source")"
else
  SOURCE_ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"
fi
readonly SOURCE_ROOT
readonly RUNTIME="$SOURCE_ROOT/ops/project-cell/minitz_project_cell_runtime.py"

[[ -f "$RUNTIME" ]] || { printf 'MiniTZ Project cell runtime missing: %s\n' "$RUNTIME" >&2; exit 1; }
export MINITZ_SOURCE_ROOT="$SOURCE_ROOT"
export PYTHONPATH="$SOURCE_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 "$RUNTIME" "$@"
