#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPO_ROOT="${BIELLA_REPO_ROOT:-/root/biella/repos/biella-engine}"
readonly RUNTIME="$REPO_ROOT/ops/project-cell/biella_project_cell_runtime.py"

[[ -f "$RUNTIME" ]] || { printf 'Biella Project cell runtime missing: %s\n' "$RUNTIME" >&2; exit 1; }
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 "$RUNTIME" "$@"
