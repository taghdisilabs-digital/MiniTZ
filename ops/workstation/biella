#!/usr/bin/env bash
set -Eeuo pipefail

readonly SELF="$(readlink -f "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd -P)"
# shellcheck source=biella-lib.sh
source "$SCRIPT_DIR/biella-lib.sh"

usage() {
  cat <<'EOF'
Usage: biella <command> [args]

Commands:
  up         Start/verify the Biella local runtime
  down       Stop Biella-owned supervised runtime services
  status     Show compact workstation status
  doctor     Run workstation diagnostics
  providers  Check configured external providers
  configure  Update provider credentials with hidden prompts
  modal      Run Modal CLI with Biella environment
  logs       Show recent Biella service logs
  cleanup    Remove known temporary Biella runtime noise
EOF
}

biella_require_root
biella_load_runtime_env
biella_ensure_runtime_dirs

command_name="${1:-status}"
[[ $# -eq 0 ]] || shift
case "$command_name" in
  up)
    biella_up_local
    printf 'Biella local runtime: READY\n'
    ;;
  down)
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files biella-ollama.service >/dev/null 2>&1; then
      systemctl stop biella-ollama.service
    else
      printf 'No Biella-owned supervised runtime service is installed.\n'
    fi
    ;;
  status)
    biella_status_basic
    if biella_qwen_loaded; then printf 'Qwen VRAM bytes: '; biella_verify_qwen_vram || true; fi
    ;;
  doctor)
    biella_status_basic
    printf 'GPU:    '; biella_gpu_status
    printf 'Disk:   '; biella_disk_status
    printf 'Codex:  '; command -v codex >/dev/null 2>&1 && codex --version || printf 'MISSING\n'
    printf 'Modal:  '; command -v modal >/dev/null 2>&1 && modal --version || printf 'MISSING\n'
    printf 'Docker: '; command -v docker >/dev/null 2>&1 && docker --version || printf 'MISSING\n'
    printf 'OpenAI-compatible Qwen API: '; biella_verify_v1_responses >/dev/null 2>&1 && printf 'READY\n' || printf 'DEGRADED\n'
    printf '\nProviders:\n'
    "$SCRIPT_DIR/biella-provider-check.sh"
    ;;
  providers)
    exec "$SCRIPT_DIR/biella-provider-check.sh" "$@"
    ;;
  configure)
    exec "$SCRIPT_DIR/biella-provider-configure.sh" "$@"
    ;;
  modal)
    biella_exec_or_fail modal "$@"
    ;;
  logs)
    if command -v journalctl >/dev/null 2>&1; then
      journalctl -u biella-ollama.service -n "${BIELLA_LOG_LINES:-80}" --no-pager 2>/dev/null || true
    fi
    ;;
  cleanup)
    biella_cleanup_legacy
    printf 'Known legacy Biella runtime noise removed.\n'
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
