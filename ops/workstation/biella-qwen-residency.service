[Unit]
Description=Biella Qwen Persistent Residency Watcher
After=biella-ollama.service
Wants=biella-ollama.service

[Service]
Type=simple
User=ollama
Group=ollama
Environment="BIELLA_OLLAMA_URL=http://127.0.0.1:11434"
Environment="BIELLA_QWEN_MODEL=qwen3-coder-next:biella"
Environment="BIELLA_QWEN_RESIDENCY_INTERVAL_SECONDS=30"
EnvironmentFile=-/etc/minitz/qwen-residency.env
ExecStart=/usr/local/lib/biella-workstation/biella-qwen-residency.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
