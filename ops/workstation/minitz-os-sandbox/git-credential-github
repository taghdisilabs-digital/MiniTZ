#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path


def request() -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in sys.stdin:
        line = raw.rstrip("\n")
        if not line:
            break
        if "=" in line:
            key, value = line.split("=", 1)
            values[key] = value
    return values


def github_record(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    active = False
    for raw in path.read_text(encoding="utf-8").splitlines():
        if raw and not raw[0].isspace():
            active = raw.strip() == "github.com:"
            continue
        if not active:
            continue
        stripped = raw.strip()
        if ":" not in stripped:
            continue
        key, value = stripped.split(":", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "get"
    values = request()
    if action != "get" or values.get("host") != "github.com" or values.get("protocol") != "https":
        return 0
    path = Path(os.environ.get("MINITZ_GITHUB_CREDENTIAL_FILE", "/resources/credentials/github/hosts.yml"))
    try:
        record = github_record(path)
    except OSError:
        return 0
    token = record.get("oauth_token", "")
    if not token:
        return 0
    print("username=x-access-token")
    print(f"password={token}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
