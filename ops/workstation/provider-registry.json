  "policy": {
    "disabled_model_families": [
      "google/"
    ],
    "free_credit_preferred": true,
    "generation_probe_forbidden": true,
    "one_provider_by_default": true,
    "paid_allowed": true,
    "quota_observation": "PASSIVE_RECEIPTS_OR_NON_BILLABLE_METADATA_ONLY",
    "quota_probe_forbidden": true,
    "resource_loop": {
      "automatic_dispatch": true,
      "explicit_owner_start_required": false,
      "failure_backoff_required": true,
      "helper_provider_pool_scope": "BOOSTER_COMMANDER_ONLY",
      "helper_provider_pool_size": 3,
      "helper_provider_selection": "ROUND_ROBIN_HEALTHY_EQUIVALENTS",
      "include_all_configured_resources_when_started": true,
      "local_qwen_booster_assist": "ENABLED_ALL_FIVE_BOOST_CONTEXTS",
      "max_consecutive_auto_selections_per_provider": 1,
      "no_duplicate_equivalent_fanout_without_need": true,
      "paid_overflow_requires_task_fit": true,
      "priority_tiers": [
        [
          "local_free_software",
          "local_compute",
          "owned_remote_compute"
        ],
        [
          "credit_or_paid"
        ]
      ],
      "quota_or_rate_limit_backoff_required": true,
      "selection_policy": "ROTATE_EQUIVALENTS_BEFORE_REUSE",
      "spread_equivalent_providers": true,
      "state": "ACTIVE_OWNER_AUTHORIZED"
    }
  },
