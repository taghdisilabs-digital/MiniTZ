#!/usr/bin/env bash
set -Eeuo pipefail

readonly RUNTIME_ENV="${BIELLA_AI_RUNTIME_ENV:-/root/.config/biella-ai/runtime.env}"
[[ "$EUID" -eq 0 ]] || { echo 'run as root' >&2; exit 1; }
[[ -f "$RUNTIME_ENV" && ! -L "$RUNTIME_ENV" ]] || { echo 'Biella runtime environment is missing' >&2; exit 1; }
[[ "$(stat -c '%u:%a' "$RUNTIME_ENV")" == "0:600" ]] || { echo 'Biella runtime environment must be root-owned 0600' >&2; exit 1; }

read -rsp 'Cloudflare Tunnel/DNS API token: ' CLOUDFLARE_TUNNEL_API_TOKEN
printf '\n'
[[ -n "$CLOUDFLARE_TUNNEL_API_TOKEN" ]] || { echo 'token is required' >&2; exit 1; }
export RUNTIME_ENV CLOUDFLARE_TUNNEL_API_TOKEN

python3 - <<'PY'
from pathlib import Path
import os, shlex
path=Path(os.environ['RUNTIME_ENV'])
value=os.environ['CLOUDFLARE_TUNNEL_API_TOKEN']
lines=path.read_text().splitlines()
out=[]; replaced=False
for line in lines:
    if line.startswith('CLOUDFLARE_TUNNEL_API_TOKEN='):
        out.append('CLOUDFLARE_TUNNEL_API_TOKEN='+shlex.quote(value)); replaced=True
    else:
        out.append(line)
if not replaced:
    out.append('CLOUDFLARE_TUNNEL_API_TOKEN='+shlex.quote(value))
tmp=path.with_name(path.name+'.tmp')
tmp.write_text('\n'.join(out)+'\n')
tmp.chmod(0o600)
os.chown(tmp,0,0)
tmp.replace(path)
PY

unset CLOUDFLARE_TUNNEL_API_TOKEN
printf 'Cloudflare control-ingress token saved separately from Workers AI credentials.\n'
