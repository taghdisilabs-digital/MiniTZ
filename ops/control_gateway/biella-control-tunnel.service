[Unit]
Description=Biella Control Cloudflare Tunnel
After=network-online.target biella-control-gateway.service
Wants=network-online.target
Requires=biella-control-gateway.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config /etc/cloudflared/biella-control.yml run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
